font.family: serif
font.serif: STIXGeneral, DejaVu Serif
mathtext.fontset: cm
axes.formatter.use_mathtext: True
font.size: 11
axes.titlesize: 12
axes.labelsize: 11
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.7
lines.linewidth: 1.5
xtick.major.width: 0.7
ytick.major.width: 0.7
xtick.direction: out
ytick.direction: out
axes.grid: False
figure.facecolor: white
axes.facecolor: white
savefig.facecolor: white
savefig.dpi: 220
svg.fonttype: none
pdf.fonttype: 42
ps.fonttype: 42
